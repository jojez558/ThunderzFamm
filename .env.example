# Copy this file to .env and fill in real values before running the server.

PORT=4000
CLIENT_URL=http://localhost:4000

# Optional MongoDB connection. Leave blank to use data/db.json.
MONGODB_URI=
MONGODB_DB_NAME=thunderz_family

# Session cookie signing secret — set this to a long random string
SESSION_SECRET=change_this_to_a_long_random_string

# --- Paystack Kenya (real payments) ---
# Get these from https://dashboard.paystack.com/#/settings/developer
PAYSTACK_SECRET_KEY=sk_test_replace_me

# --- Outgoing email (booking + contact notifications) ---
# Any SMTP provider works (Gmail app password, SendGrid, Mailgun, Zoho, etc.)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=you@example.com
SMTP_PASS=your_smtp_password
FROM_EMAIL="Thunderz Family" <no-reply@motiontribe.co.ke>
NOTIFY_EMAIL=bookings@motiontribe.co.ke

# Default admin login password is "changeme123" (set on first run) — change it
# from the admin panel immediately after your first login.
